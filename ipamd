def signal_cleanup(signum, frame):
#    httpd.server_close()
    print("server shutdown")
    sys.exit(0)


def http_server(config):
    httpd = None
    db = ipam(database=config_get(config,'database','type'), dbfile=config_get(config,'database','path'))
    server = config_get(config,'server','listen')
    port = config_get(config,'server','port')
    port = int(port)
    rbac = load_rbac_config(config)
    if rbac == None:
        print("no rbac settings found")
        sys.exit(1)

    try:
        httpd = IPAMDServer((server,port), IPAMDRequestHandler)
        httpd.rbac = rbac
        httpd.dbhandle = db
    except OSError:
        print("Cannot bind to {}:{}".format(server,port))
        sys.exit(1)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    httpd.server_close()

def usage():
    print("""ipamd [-h] [-c config.ini] 
    -c      alternate ini file
    -h      this help
    -d      do not daemonize
    -v      show version
    """)

def load_rbac_config(config):
    users={}
    if config == None:
        return None
    for r in config:
        re_rbac = re.compile('^rbac_(.*)$')
        match = re_rbac.match(r)
        if match != None:
            name = match.group(1)
            if name != None:
                key=config_get(config,r,'key',None)
                actions=config_get(config,r,'actions',None)
                domains=config_get(config,r,'domains',None)
                resources=config_get(config,r,'resources',None)
                types=config_get(config,r,'types',None)
                if actions != None:
                    actions = actions.split(',')
                if domains != None:
                    domains = domains.split(',')
                if resources != None:
                    resources = resources.split(',')
                if types != None:
                    types = types.split(',')
                users[name] = {
                    'key': key,
                    'actions': actions,
                    'domains': domains,
                    'resources': resources,
                    'types': types
                }
    return users

def config_get(config=None, section=None, item=None, default=None):
    if config == None or section == None or item == None:
        return None
    try:
        val = config.get(section,item)
    except:
        val = default
    return val

def main():
    do_daemon = True
    ini_files = ['/etc/ipam.ini', os.path.expanduser('~/.ipam.ini')]

    sys.argv.pop(0)     # skip the command
    while len(sys.argv) != 0:
        if sys.argv[0][0] == "-":   # -argument
            if sys.argv[0] == "-h":
                usage()
                sys.exit(1)
            elif sys.argv[0] == "-d":
                do_daemon = False
            elif sys.argv[0] == "-c":
                sys.argv.pop(0)
                if sys.argv != []:
                    ini_files.append(sys.argv[0])
                else:
                    print("required argument missing for -c")
                    sys.exit(1)
            elif sys.argv[0] == "-v":
                print(f'ipamd version:{IPAMD_VERSION}\nlibipam version:{ipam.VERSION}')
                sys.exit(0)
            sys.argv.pop(0)
        else:
            break;  # ran out of flags... so bail

    config = configparser.ConfigParser()
    val = config.read(ini_files)
    logfile = config_get(config,'server','logfile','/var/log/ipamd.log')

    if val == []:
        print("no configuration found. aborting")
        sys.exit(2)

    # we cannot use the API DB type
    if config_get(config,'database','type') not in ['sqlite3']:
        print("no database type specified")
        sys.exit(1)

    if config_get(config,'database','path') == None:
        print("no database file specified")
        sys.exit(1)

    if do_daemon == True:
        logger = logging.getLogger('ipamd')
        logger.setLevel(logging.DEBUG)
        lfh = logging.FileHandler(logfile)
        logger.addHandler(lfh)
        user = config_get(config,'server','user')
        uid=None
        git=None
        if user != None:
            try:
                u = getpwnam(user)
            except KeyError:
                pass
            uid = u.pw_uid
            gid = u.pw_uid
        with daemon.DaemonContext(uid=uid,gid=gid,stdout=lfh.stream,stderr=lfh.stream,signal_map={signal.SIGTERM: signal_cleanup}):
            print("starting server")
            http_server(config)
    else:
        print("starting server")
        http_server(config)
        print("closing server")

    sys.exit(0)

if __name__ == "__main__":
    main()
